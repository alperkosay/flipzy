{
  "name": "flipzy",
  "version": "0.1.0",
  "description": "Realistic page-flip (flipbook) component for React and Next.js. Zero runtime dependencies, fully typed.",
  "keywords": [
    "react",
    "nextjs",
    "flipbook",
    "page-flip",
    "book",
    "magazine",
    "turnjs",
    "typescript"
  ],
  "license": "MIT",
  "author": "Alper",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint && attw --pack . --profile node16 --exclude-entrypoints styles.css",
    "size": "node scripts/size.mjs",
    "audit": "npm audit --audit-level=low",
    "security": "npm audit --audit-level=low && node scripts/check-pack.mjs",
    "release:check": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:package && npm run size && npm run security"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
